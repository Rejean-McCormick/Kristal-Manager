{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kristal.example/schema/v7/kristall-property-registry.schema.json",
  "title": "Kristall Property Registry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_type",
    "namespace_id",
    "registry_id",
    "properties"
  ],
  "properties": {
    "schema_version": {
      "const": "7.0"
    },
    "artifact_type": {
      "const": "kristall_property_registry"
    },
    "namespace_id": {
      "type": "string",
      "minLength": 1
    },
    "registry_id": {
      "type": "string"
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "property_id",
          "preferred_label",
          "status"
        ],
        "properties": {
          "property_id": {
            "type": "string",
            "pattern": "^KP[1-9][0-9]*$"
          },
          "preferred_label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "provisional",
              "stable",
              "deprecated"
            ]
          },
          "external_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/external_mapping"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "external_mapping": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "system",
        "id",
        "mapping_semantics"
      ],
      "properties": {
        "system": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "mapping_semantics": {
          "enum": [
            "exact",
            "close",
            "broader",
            "narrower",
            "related"
          ]
        }
      }
    }
  }
}
